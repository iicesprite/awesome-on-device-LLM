# 本地资料：PDF、网页快照仅保存在本机。
# 笔记配图放在 resources/assets/，随 Git 同步。
**/resources/*
!**/resources/assets/

# Local Python environment and caches.
.venv/
.local/
.obsidian/
__pycache__/
*.py[cod]

# GitHub Pages: generated content, dependencies and build outputs.
site/node_modules/
site/.generated/
site/.vitepress/cache/
site/.vitepress/dist/
