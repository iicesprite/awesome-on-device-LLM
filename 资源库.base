filters:
  and:
    - /^(papers|blogs|docs)\/[^/]+\/resource\.md$/.matches(file.path)
formulas:
  resource: link(file.path, note.id)
  topics: list(note.tags).filter(value.startsWith("#topic/"))
  hardware: list(note.tags).filter(value.startsWith("#hardware/"))
properties:
  formula.resource:
    displayName: 打开卡片
  note.title:
    displayName: 标题
  note.type:
    displayName: 类型
  note.year:
    displayName: 年份
  note.status:
    displayName: 阅读状态
  note.tags:
    displayName: 标签
  note.summary:
    displayName: 收藏理由
  note.url:
    displayName: 来源
  formula.topics:
    displayName: 研究主题
  formula.hardware:
    displayName: 设备
views:
  - type: table
    name: 全部资源
    order:
      - formula.resource
      - title
      - type
      - year
      - status
      - tags
      - summary
      - url
    sort:
      - property: year
        direction: DESC
      - property: title
        direction: ASC
  - type: table
    name: 阅读队列
    filters:
      or:
        - note.status == "unread"
        - note.status == "reading"
    order:
      - formula.resource
      - title
      - status
      - tags
      - summary
    sort:
      - property: tags
        direction: ASC
      - property: status
        direction: ASC
      - property: title
        direction: ASC
    columnSize:
      note.tags: 287
  - type: table
    name: 主题专题
    filters:
      and:
        - formula.topics.length > 0
    order:
      - formula.resource
      - title
      - formula.topics
      - tags
      - status
      - summary
  - type: table
    name: 设备专题
    filters:
      and:
        - formula.hardware.length > 0
    order:
      - formula.resource
      - title
      - formula.hardware
      - tags
      - status
      - summary
  - type: table
    name: 稀疏注意力
    filters:
      and:
        - file.hasTag("system/sparse-inference")
        - /attention|注意力|\bkv\b/i.matches(note.title + " " + note.summary)
    order:
      - formula.resource
      - title
      - year
      - status
      - tags
      - summary
      - url
    sort:
      - property: year
        direction: DESC
      - property: title
        direction: ASC
